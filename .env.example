# Supabase (Gratuit - 500 Mo)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre_service_role_key

# Google Places API (Crédit gratuit mensuel $200 de Google Cloud)
GOOGLE_PLACES_API_KEY=AIzaSy...

# IA Designer (100% Gratuit)
# Option 1: Google Gemini 2.0 / 1.5 Flash (Gratuit via Google AI Studio: aistudio.google.com)
GEMINI_API_KEY=AIzaSy...
# Option 2: Groq Llama 3.3 70B (Gratuit via console.groq.com)
GROQ_API_KEY=gsk_...

# GitHub Pages pour l'hébergement gratuit des sites clients (0 frais)
# Token GitHub personnel avec permission "repo"
GITHUB_TOKEN=ghp_...
# Votre organisation ou compte GitHub
GITHUB_REPO_OWNER=votre-username
# Nom du dépôt contenant les sites des prospects (ex: prospect-sites)
GITHUB_REPO_NAME=prospect-sites
